{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "rm -rf public && mkdir -p public && cp -a demo/. public/ && mkdir -p public/docs/demo && cp -f docs/demo/*.png public/docs/demo/",
  "outputDirectory": "public",
  "installCommand": "echo 'static demo — no install'",
  "framework": null,
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
